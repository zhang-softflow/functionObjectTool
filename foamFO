def find_db():
    """Return the database path according to the lookup order."""
    env = os.environ.get("FOAMFO_DB")
    if env:
        if not Path(env).is_file():
            sys.exit(f"Error: FOAMFO_DB={env} not found.")
        return Path(env)
    ver = current_version()
    if ver and user_db_path(ver).is_file():
        return user_db_path(ver)
    return BUNDLED_DB


def load_db():
    path = find_db()
    if not path.is_file():
        sys.exit("Error: database not found. Run 'foamFO build' first.")
    db = json.loads(path.read_text(encoding="utf-8"))
    ver = current_version()
    if ver and path == BUNDLED_DB and db.get("version") != ver and not os.environ.get("FOAMFO_QUIET"):
        print(f"Warning: bundled database is for {db.get('version')}, but the "
              f"environment is {ver}. Run 'foamFO build' for an exact match.",
              file=sys.stderr)
    return db


def use_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if use_color() else text


def short_group(g):
    return re.sub(r"^grp|FunctionObjects$", "", g) or "-"


def lookup(db, name):
    fos = db["functionObjects"]
    if name in fos:
        return fos[name]
    low = {k.lower(): k for k in fos}
    if name.lower() in low:
        return fos[low[name.lower()]]
    close = [k for k in fos if name.lower() in k.lower()]
    msg = f"Error: unknown function object '{name}'."
    if close:
        msg += " Did you mean: " + ", ".join(close[:10]) + " ?"
    sys.exit(msg)


def print_rows(entries):
    w = max([len(e["name"]) for e in entries] + [4])
    for e in entries:
        flag = "F" if e["includeFunc"] else " "
        flag += "T" if e["tutorials"] else " "
        s = e["summary"]
        if len(s) > 80:
            s = s[:77] + "..."
        print(f"{c(e['name'].ljust(w), '1;36')}  {flag}  "
              f"{short_group(e['group']):<16} {s}")


def cmd_list(args):
    db = load_db()
    es = [e for e in db["functionObjects"].values()
          if args.all or e["kind"] == "functionObject"]
    if args.group:
        es = [e for e in es if args.group.lower() in e["group"].lower()]
    if args.groups:
        cnt = {}
        for e in es:
            cnt[short_group(e["group"])] = cnt.get(short_group(e["group"]), 0) + 1
        for g, n in sorted(cnt.items()):
            print(f"{g:<24}{n}")
        return
    print_rows(es)
    print(f"\n{len(es)} entries  (F: #includeFunc template, T: used in tutorials)")


def cmd_search(args):
    db = load_db()
    words = [w.lower() for w in args.keywords]
    hits = []
    for e in db["functionObjects"].values():
        if e["kind"] != "functionObject" and not args.all:
            continue
        hay_name = e["name"].lower()
        hay = " ".join([e["name"], e["description"], e["header"], " ".join(e["includeFunc"]),
                        e.get("aliases", ""),
                        " ".join(r["name"] for t in e["tables"] for r in t["rows"])]).lower()
        if all(w in hay for w in words):
            score = sum(3 for w in words if w in hay_name) + \
                sum(1 for w in words if w in e["summary"].lower()) + \
                sum(2 for w in words if w in e.get("aliases", "").lower())
            hits.append((-score, e["name"].lower(), e))
    if not hits:
        print("No match.")
        return
    print_rows([h[2] for h in sorted(hits)])


def format_tables(e, only_required=False):
    out = []
    for t in e["tables"]:
        rows = [r for r in t["rows"] if not only_required or r["reqd"] == "yes"]
        if not rows:
            continue
        if t["heading"]:
            out.append(c(f"  [{t['heading']}]", "1"))
        wn = max(len(r["name"]) for r in rows)
        wt = max([len(r["type"]) for r in rows] + [4])
        out.append(f"  {'Property'.ljust(wn)}  {'Type'.ljust(wt)}  Reqd  Default        Description")
        for r in rows:
            name = r["name"].ljust(wn)
            if r["reqd"] == "yes":
                name = c(name, "1;31")
            out.append(f"  {name}  {r['type'].ljust(wt)}  {r['reqd'][:4]:<4}  "
                       f"{(r['default'] or '-')[:13]:<13}  {r['desc']}")
    return "\n".join(out)


