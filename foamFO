def cmd_example(args):
    db = load_db()
    e = lookup(db, args.name)
    root = project_dir(args.src, required=False)
    if not e["tutorials"]:
        print(f"'{e['name']}' is not used in the tutorials. Header example:\n")
        print(e["example"])
        return
    if root is None:
        print("OpenFOAM tutorials not found (source the OpenFOAM environment or use "
              "--src). Files using it:")
        for rel in e["tutorials"][: args.max * 3]:
            print("  " + rel)
        return
    shown = 0
    for rel in e["tutorials"]:
        if not (root / rel).is_file():
            continue
        lines = read_text(root / rel).splitlines()
        for i, l in enumerate(lines):
            m = TYPE_ENTRY_RE.match(l)
            if not m or m.group(1) != e["name"]:
                continue
            blk = find_brace_block(lines, i)
            if blk:
                print(c(f"// ---- {rel}:{blk[0] + 1}", "1;32"))
                print("\n".join(lines[blk[0]: blk[1] + 1]))
            else:
                print(c(f"// ---- {rel} (whole file)", "1;32"))
                print("\n".join(lines))
            print()
            shown += 1
            if shown >= args.max:
                left = len(e["tutorials"])
                print(f"(showed {shown}; {left} file(s) use it, use -m to show more)")
                return


