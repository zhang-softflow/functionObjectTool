    "fieldAverage": "time average mean rms prime2mean 時間平均",
    "fieldMinMax": "min max minimum maximum 最大 最小",
    "probes": "probe point monitor sampling プローブ 点",
    "sets": "line sample graph profile サンプリング 線",
