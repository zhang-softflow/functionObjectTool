def build_entry(e, entry_name, mode):
    """Create a dictionary entry text from the header example."""
    ex = e["example"]
    if not ex:
        ex = "{0}\n{{\n    type    {1};\n    libs    ({2});\n}}".format(
            entry_name, e["name"], " ".join(e["libs"]))
    lines = ex.splitlines()
    # Rename the top-level dictionary
    for i, l in enumerate(lines):
        if l.strip() and not l.strip().startswith("//"):
            if re.match(r"^[\w<>.\-]+\s*$", l.strip()):
                lines[i] = entry_name
            break
    required = {r["name"] for t in e["tables"] for r in t["rows"] if r["reqd"] == "yes"}
    # Locate the outer braces of the top-level dictionary
    first = next((i for i, l in enumerate(lines) if l.strip() == "{"), None)
    last = max((i for i, l in enumerate(lines) if l.strip() == "}"), default=None)
    has_markers = any(l.strip().startswith("//") and "mandatory" in l.lower() for l in lines)
    out = []
    section = "mandatory"
    depth = 0
    for i, l in enumerate(lines):
        s = l.strip()
        low = s.lower()
        if depth <= 1 and low.startswith("//"):
            if "conditional" in low:
                section = "conditional"
            elif "optional" in low:
                section = "optional"
            elif "inherited" in low:
                section = "inherited"
            elif "mandatory" in low:
                section = "mandatory"
        nopen = s.count("{") - s.count("}") if not s.startswith("//") else 0
        if s in ("...", "// ..."):
            depth += nopen
            continue
        key = re.match(r"^([\w\-]+)\s", s + " ")
        is_req = depth == 1 and bool(key) and key.group(1) in required and ";" in s
        outer = first is None or i <= first or i == last
        # Without section markers, treat nested dictionaries as optional
        nested = False
        if not has_markers and not outer:
            nxt = next((x.strip() for x in lines[i + 1:] if x.strip()), "")
            nested = depth >= 2 or nopen > 0 or \
                (depth == 1 and re.match(r"^[\w<>\-]+$", s) is not None and nxt.startswith("{"))
        if outer or (section == "mandatory" and not nested) or is_req:
            out.append(l)
        elif mode == "full":
            if s and not s.startswith("//"):
                out.append(re.sub(r"^(\s*)", r"\1// ", l, count=1))
            else:
                out.append(l)
        depth += nopen
    # Drop dangling comment headers / blank runs
    clean = []
    for l in out:
        if not l.strip() and clean and not clean[-1].strip():
            continue
        clean.append(l)
    if mode != "full":
        clean = [l for j, l in enumerate(clean)
                 if not (l.strip().startswith("//") and
                         (j + 1 >= len(clean) or not clean[j + 1].strip()
                          or clean[j + 1].strip() == "}"))]
    out = [l for j, l in enumerate(clean)
           if not (not l.strip() and j + 1 < len(clean) and clean[j + 1].strip() == "}")]
    text = "\n".join(out)
    # Ensure the libs entry exists
    if e["libs"] and not LIBS_RE.search(text):
        text = re.sub(r"(^\s*type\s+[\w:.]+\s*;[^\n]*\n)",
                      r"\1    libs            (" + " ".join(e["libs"]) + ");\n",
                      text, count=1, flags=re.M)
    if mode == "full":
        # Document optional parameters missing from the example
        present = set(re.findall(r"^\s*(?://\s*)?(\w+)\s", text, re.M))
        extra = [r for t in e["tables"] for r in t["rows"]
                 if r["name"] not in present and re.match(r"^\w+$", r["name"])]
        if extra:
            add = ["", "    // Further entries documented in the header:"]
            for r in extra:
                d = f" (default: {r['default']})" if r["default"] else ""
                add.append(f"    // {r['name']:<16} <{r['type'] or 'value'}>;  "
                           f"// {r['desc']}{d}")
            idx = text.rfind("}")
            text = text[:idx].rstrip("\n") + "\n" + "\n".join(add) + "\n" + text[idx:]
        text += ("\n\n// Common entries (functionObject.H): writeControl, writeInterval,"
                 "\n// executeControl, executeInterval, timeStart, timeEnd, enabled, log")
    return text


def cmd_add(args):
    db = load_db()
    e = lookup(db, args.name)
    case = Path(args.case).resolve()
    sysdir = case / "system"
    entry_name = args.entry or e["name"] + "1"
    text = build_entry(e, entry_name, "full" if args.full else "minimal")
    stamp = date.today().isoformat()
    body = (f"// Generated by foamFO from {e['header']} ({stamp})\n"
            f"// Include it inside controlDict 'functions {{ }}':  #include \"{entry_name}\"\n\n"
            f"{text}\n")
    placeholders = sorted(set(re.findall(r"<[\w ,:/|]+>", re.sub(r"//.*", "", text))))
    if args.stdout:
        print(body)
    else:
        if not sysdir.is_dir():
            sys.exit(f"Error: {sysdir} does not exist (use -case)")
        target = sysdir / entry_name
        if target.exists() and not args.force:
            sys.exit(f"Error: {target} exists (use -f to overwrite)")
        target.write_text(body, encoding="utf-8")
        print(f"Wrote {target}")
        if args.insert:
            insert_include(sysdir / "controlDict", entry_name)
        else:
            print(f"Add to controlDict functions {{ }}:  #include \"{entry_name}\"")
    if placeholders:
        print(c("Edit these placeholders before running: ", "1;31") + " ".join(placeholders),
              file=sys.stderr)


def insert_include(cdict, entry_name):
    if not cdict.is_file():
        sys.exit(f"Error: {cdict} not found")
    text = read_text(cdict)
    inc = f'#include "{entry_name}"'
    if inc in text:
        print(f"{cdict.name} already contains {inc}")
        return
    bak = cdict.with_name(cdict.name + ".bak")
    if not bak.exists():  # keep the oldest (original) backup
        shutil.copy2(cdict, bak)
    lines = text.splitlines()
    start = None
    for i, l in enumerate(lines):
        if re.match(r"^functions\b", l):
            start = i
            break
    if start is not None:
        blk = None
        for j in range(start, min(start + 3, len(lines))):
            if "{" in lines[j]:
                depth = 0
                for k in range(j, len(lines)):
                    s = re.sub(r"//.*", "", lines[k])
                    depth += s.count("{") - s.count("}")
                    if depth == 0:
                        blk = k
                        break
                break
        if blk is None:
            sys.exit("Error: could not parse the functions block; edit controlDict manually")
        if lines[blk].strip() == "}":
            lines.insert(blk, "    " + inc)
        else:
            idx = lines[blk].rfind("}")
            lines[blk] = lines[blk][:idx] + inc + " " + lines[blk][idx:]
    else:
        tail = None
        for i in range(len(lines) - 1, -1, -1):
            if lines[i].startswith("// *****"):
                tail = i
                break
        new = ["functions", "{", "    " + inc, "}", ""]
        if tail is None:
            lines += [""] + new
        else:
            lines[tail:tail] = new
    cdict.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"Inserted {inc} into {cdict} (backup: {cdict.name}.bak)")


