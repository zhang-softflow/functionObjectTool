SECTION_RE = re.compile(r"^([A-Z][A-Za-z ]{1,30})\s*$")
TYPENAME_RE = re.compile(r'\bTypeName(?:NoDebug)?\s*\(\s*"([^"]+)"\s*\)')
REGISTER_RE = re.compile(
    r"addToRunTimeSelectionTable\s*\(\s*functionObject\s*,\s*([\w:<>, ]+?)\s*,\s*dictionary\s*\)"
)
GROUP_RE = re.compile(r"^\s*(grp\w*FunctionObjects)\s*$", re.M)
TYPE_ENTRY_RE = re.compile(r"^\s*type\s+([\w:.]+)\s*;", re.M)
LIBS_RE = re.compile(r"^\s*libs\s*\(([^)]*)\)\s*;", re.M)
LINK_RE = re.compile(r"\\link\s+([\w.]+)\s+\\endlink")


# ---------------------------------------------------------------------------
# Generic helpers
# ---------------------------------------------------------------------------

def is_foam_root(path):
    return path is not None and Path(path, "src", "OpenFOAM").is_dir()


def project_dir(arg=None, required=True):
    """Return the OpenFOAM source root directory (or None if not found).

    Search order: explicit argument, $WM_PROJECT_DIR, two levels above this
    script (when installed inside an OpenFOAM tree, e.g. <root>/myTools/foamFO).
    """
    if arg:
        cands = [Path(arg)]
    else:
        cands = []
        env = os.environ.get("WM_PROJECT_DIR")
        if env:
            cands.append(Path(env))
        cands.append(TOOL_DIR.parent.parent)
    for c_ in cands:
        if is_foam_root(c_):
            return c_.resolve()
    if required:
        sys.exit("Error: OpenFOAM source tree not found. Source the OpenFOAM "
                 "environment (etc/bashrc) or use --src <OpenFOAM root>.")
    return None


def user_db_path(version):
    base = os.environ.get("XDG_DATA_HOME") or str(Path.home() / ".local" / "share")
    return Path(base) / "foamFO" / f"foDatabase-{version}.json"


def current_version():
    env = os.environ.get("WM_PROJECT_DIR")
    return Path(env).name if env else None


def read_text(path):
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def header_comment(text):
    """Return the leading documentation comment block of a source file."""
    m = re.search(r"\\\*-{5,}[-*]*\*/", text)
    if not m:
        return ""
    block = text[: m.start()]
    # Drop the OpenFOAM banner / licence part
    idx = block.find("\nClass")
    if idx < 0:
        idx = block.find("\nDescription")
    return block[idx + 1:] if idx >= 0 else block


def split_sections(comment):
    """Split a doxygen header comment into {SectionName: text}."""
    sections = {}
    current = None
    buf = []
    for line in comment.splitlines():
        m = SECTION_RE.match(line)
        if m and not line.startswith(" "):
            if current:
                sections[current] = "\n".join(buf)
            current = m.group(1).strip()
            buf = []
        elif current:
            buf.append(line)
    if current:
        sections[current] = "\n".join(buf)
    return sections


def dedent(text):
    lines = text.splitlines()
    ind = [len(l) - len(l.lstrip()) for l in lines if l.strip()]
    cut = min(ind) if ind else 0
    return "\n".join(l[cut:] for l in lines).strip("\n")


def extract_verbatims(text):
    """Return \\verbatim blocks; tolerate a missing \\endverbatim."""
    out = []
    parts = re.split(r"\\verbatim[ \t]*\n", text)
    for part in parts[1:]:
        end = part.find("\\endverbatim")
        if end >= 0:
            out.append(dedent(part[:end]))
            continue
        # Unterminated block: stop at the brace closing the first dictionary
        lines = part.splitlines()
        first = next((l for l in lines if l.strip()), "")
        ind = len(first) - len(first.lstrip())
        blk = []
        for l in lines:
            blk.append(l)
            if l.strip() == "}" and len(l) - len(l.lstrip()) == ind:
                break
        out.append(dedent("\n".join(blk)))
    return out


def clean_doxygen(text):
    """Remove doxygen markup from prose."""
    text = re.sub(r"\\verbatim.*?\\endverbatim", "", text, flags=re.S)
    text = re.sub(r"\\table.*?\\endtable", "", text, flags=re.S)
    text = re.sub(r"<!--\s*\n\s*-->", " ", text)
    text = LINK_RE.sub(r"\1", text)
    text = re.sub(r"\\(c|a|b|em|p)\s+", "", text)
    text = re.sub(r"\\vartheta", "theta", text)
    text = re.sub(r"\\heading\s+", "", text)
    text = re.sub(r"\\f\[.*?\\f\]", "[formula]", text, flags=re.S)
    text = re.sub(r"\\f\$(.*?)\\f\$", r"\1", text, flags=re.S)
    text = re.sub(r"\n\s*\n\s*\n+", "\n\n", text)
    return dedent(text)


def parse_tables(text):
    """Parse every \\table ... \\endtable block into a list of row dicts."""
    tables = []
    for m in re.finditer(r"(?:\\heading\s+([^\n]*)\n\s*)?\\table\s*\n(.*?)\\endtable",
                         text, re.S):
        heading = (m.group(1) or "").strip()
        body = re.sub(r"<!--\s*\n\s*-->", " ", m.group(2))
        lines = [l.strip() for l in body.splitlines() if "|" in l]
        if not lines:
            continue
        head = [c.strip().lower() for c in lines[0].split("|")]
        cols = {}
        for i, h in enumerate(head):
            if h.startswith("prop") or h in ("entry", "keyword", "name"):
                cols.setdefault("name", i)
            elif h.startswith("desc"):
                cols.setdefault("desc", i)
            elif h.startswith("type"):
                cols.setdefault("type", i)
            elif h.startswith("req") or h.startswith("mand"):
                cols.setdefault("reqd", i)
            elif h.startswith("def"):
                cols.setdefault("default", i)
        if "name" not in cols:
            continue
        rows = []
        for l in lines[1:]:
            cells = [c.strip() for c in l.split("|")]

            def cell(key):
                i = cols.get(key)
                return cells[i] if i is not None and i < len(cells) else ""
            name = cell("name")
            if not name:
                continue
            reqd = cell("reqd").lower()
            rows.append({
                "name": name,
                "desc": re.sub(r"\s+", " ", LINK_RE.sub(r"\1", cell("desc"))),
                "type": cell("type"),
                "reqd": "yes" if reqd.startswith(("yes", "y")) else
                        ("no" if reqd.startswith("no") else reqd),
                "default": cell("default").strip("-").strip() if cell("default") != "-" else "",
            })
        if rows:
            tables.append({"heading": heading, "rows": rows})
    return tables


def lib_from_make(header):
    """Find the library a source belongs to via the nearest Make/files."""
    d = Path(header).parent
    for _ in range(8):
        mf = d / "Make" / "files"
        if mf.is_file():
            m = re.search(r"^\s*LIB\s*=\s*\$\(FOAM_\w+\)/lib(\w+)", read_text(mf), re.M)
            if m:
                return m.group(1)
            m = re.search(r"^\s*EXE\s*=", read_text(mf), re.M)
            if m:
                return ""
        if d.parent == d:
            break
        d = d.parent
    return ""


def find_brace_block(lines, idx):
    """Return (start, end) line indices of the dictionary enclosing lines[idx]."""
    depth = 0
    start = None
    for i in range(idx, -1, -1):
        s = re.sub(r"//.*", "", lines[i])
        depth += s.count("}") - s.count("{")
        if depth < 0:
            start = i
            break
    if start is None:
        return None
    # Include the dictionary name when the brace is on its own line
    if lines[start].strip() == "{" and start > 0 and lines[start - 1].strip():
        start -= 1
    depth = 0
    for j in range(start, len(lines)):
        s = re.sub(r"//.*", "", lines[j])
        depth += s.count("{") - s.count("}")
        if depth == 0 and "{" in "".join(lines[start:j + 1]):
            return start, j
    return None


# ---------------------------------------------------------------------------
# Database build
# ---------------------------------------------------------------------------

def parse_header(root, hpath):
    text = read_text(hpath)
    comment = header_comment(text)
    secs = split_sections(comment)
    usage = secs.get("Usage", "")
    desc_raw = secs.get("Description", "")
    verbs = extract_verbatims(usage) + extract_verbatims(desc_raw)
    tables = parse_tables(usage) + parse_tables(desc_raw)
    # Fallback: documentation in the .C/.cxx file
    if not verbs or not tables:
        for ext in (".C", ".cxx"):
            src = hpath.with_suffix(ext)
            if src.is_file():
                s2 = split_sections(header_comment(read_text(src)))
                for key in ("Usage", "Description"):
                    if not verbs:
                        verbs = extract_verbatims(s2.get(key, ""))
                    if not tables:
                        tables = parse_tables(s2.get(key, ""))
    inherited = sorted(set(LINK_RE.findall(usage + desc_raw)) - {hpath.name})
    gm = GROUP_RE.search(secs.get("Group", "") + "\n" + comment)
    see_also = clean_doxygen(secs.get("See also", ""))
    notes = clean_doxygen(secs.get("Note", ""))
    return {
        "text": text,
        "description": clean_doxygen(desc_raw),
        "verbatims": verbs,
        "tables": tables,
        "inherited": [i for i in inherited if i.endswith(".H")],
        "group": gm.group(1) if gm else "",
        "seeAlso": see_also,
        "note": notes,
    }


def pick_example(verbs, tname):
    """Choose the verbatim block that is a usage example of 'tname'."""
    for v in verbs:
        if re.search(r"^\s*type\s+" + re.escape(tname) + r"\s*;", v, re.M):
            return v
    for v in verbs:
        if TYPE_ENTRY_RE.search(v):
            return v
    return verbs[0] if verbs else ""


def guess_group(rel):
    parts = rel.split("/")
    if parts[:2] == ["src", "functionObjects"] and len(parts) > 2:
        return "grp" + parts[2][0].upper() + parts[2][1:] + "FunctionObjects"
    return "grpOtherFunctionObjects"


def scan_templates(root):
    """Map function object type -> list of #includeFunc template names."""
    base = root / "etc" / "caseDicts" / "postProcessing"
    out = {}
    if not base.is_dir():
        return out
    for f in sorted(base.rglob("*")):
        if not f.is_file() or f.suffix == ".cfg":
            continue
        text = read_text(f)
        seen = set()
        tname = None
        # Follow #includeEtc chain to find the type entry
        while True:
            # The function object type is the top-level (unindented) entry
            m = re.search(r"^type\s+([\w:.]+)\s*;", re.sub(r"//.*", "", text), re.M)
            if m:
                tname = m.group(1)
                break
            inc = re.search(r'#includeEtc\s+"([^"]+)"', text)
            if not inc or inc.group(1) in seen:
                break
            seen.add(inc.group(1))
            text = read_text(root / "etc" / inc.group(1))
        if tname:
            out.setdefault(tname, []).append(str(f.relative_to(base)))
    return out


def scan_tutorials(root, names):
    """Map function object type -> list of tutorial files using it."""
    out = {}
    tut = root / "tutorials"
    if not tut.is_dir():
        return out
    for f in tut.rglob("*"):
        if not f.is_file() or "system" not in f.parts:
            continue
        if f.stat().st_size > 400000:
            continue
        text = read_text(f)
        for m in TYPE_ENTRY_RE.finditer(text):
            t = m.group(1)
            if t in names:
                rel = str(f.relative_to(root))
                lst = out.setdefault(t, [])
                if rel not in lst:
                    lst.append(rel)
    for t in out:
        out[t].sort()
    return out


def cmd_build(args):
    root = project_dir(args.src)
    print(f"Scanning {root} ...")

    # (a) headers of classes registered as functionObject
    candidates = {}
    for d in ("src", "applications", "modules"):
        if not (root / d).is_dir():
            continue
        for f in (root / d).rglob("*"):
            if f.suffix not in (".C", ".cxx", ".H") or not f.is_file():
                continue
            # Skip build artefacts (lnInclude copies, platforms, Make)
            if SKIP_DIRS.intersection(f.relative_to(root).parts):
                continue
            text = read_text(f)
            if f.suffix in (".C", ".cxx") and REGISTER_RE.search(text):
                h = f.with_suffix(".H")
                if h.is_file() and TYPENAME_RE.search(read_text(h)):
                    candidates[h] = "registered"
                else:
                    # Templated registration (e.g. xxxFunctionObjects.C):
                    # mark the documented headers of the same directory
                    for hh in sorted(f.parent.glob("*.H")):
                        if TYPENAME_RE.search(read_text(hh)):
                            candidates[hh] = "registered"
            elif f.suffix == ".H" and GROUP_RE.search(header_comment(text)):
                candidates.setdefault(f, "group")

    entries = {}
    for h, how in sorted(candidates.items()):
        rel = str(h.relative_to(root))
        info = parse_header(root, h)
        names = TYPENAME_RE.findall(info["text"])
        if not names:
            continue
        tname = names[0]
        if rel.startswith("applications/test"):
            continue
        example = pick_example(info["verbatims"], tname)
        # Classify: cloud functions, usable function objects, base classes
        if "CloudFunctionObject" in rel or "lagrangian/intermediate" in rel:
            kind = "cloudFunction"
        elif how == "registered" or re.search(
                r"^\s*type\s+" + re.escape(tname) + r"\s*;", example, re.M):
            kind = "functionObject"
        else:
            kind = "base"
        libs = []
        lm = LIBS_RE.search(example)
        if lm:
            libs = [x.strip().strip('"') for x in lm.group(1).split()]
        if not libs and kind == "functionObject":
            lib = lib_from_make(h)
            if lib:
                libs = [lib]
        desc = info["description"]
        summary = desc.split("\n\n")[0].replace("\n", " ").strip()
        e = {
            "name": tname,
            "kind": kind,
            "registered": how == "registered",
            "group": info["group"] or guess_group(rel),
            "header": rel,
            "libs": libs,
            "summary": summary,
            "description": desc,
            "example": example,
            "otherExamples": [v for v in info["verbatims"] if v != example][:4],
            "tables": info["tables"],
            "inherited": info["inherited"],
            "note": info["note"],
            "seeAlso": info["seeAlso"],
        }
        # Prefer registered entries on name clashes
        old = entries.get(tname)
        if old is None or (e["registered"] and not old["registered"]):
            entries[tname] = e

    templates = scan_templates(root)
    tutorials = scan_tutorials(root, set(entries))
    for n, e in entries.items():
        e["includeFunc"] = templates.get(n, [])
        e["tutorials"] = tutorials.get(n, [])
        e["aliases"] = ALIASES.get(n, "")

    # Base headers documenting inherited entries
    bases = {}
    for b in BASE_HEADERS:
        p = root / b
        if p.is_file():
            info = parse_header(root, p)
            bases[p.name] = {
                "header": b,
                "summary": info["description"].split("\n\n")[0].replace("\n", " "),
                "tables": info["tables"],
            }

    db = {
        "version": root.name,
        "built": date.today().isoformat(),
        "functionObjects": dict(sorted(entries.items(), key=lambda kv: kv[0].lower())),
        "bases": bases,
    }
    out = Path(args.output) if args.output else user_db_path(root.name)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(db, indent=1, ensure_ascii=False), encoding="utf-8")

    fo = [e for e in entries.values() if e["kind"] == "functionObject"]
    noex = sorted(e["name"] for e in fo if not e["example"])
    notab = sorted(e["name"] for e in fo if not e["tables"])
    print(f"Wrote {out}")
    if not args.output and current_version() != root.name:
        print(f"  note: used automatically when $WM_PROJECT_DIR ends with '{root.name}';"
              f" otherwise set FOAMFO_DB={out}")
    print(f"  function objects : {len(fo)}")
    print(f"  cloud functions  : {sum(1 for e in entries.values() if e['kind'] == 'cloudFunction')}")
    print(f"  base classes     : {sum(1 for e in entries.values() if e['kind'] == 'base')}")
    print(f"  with example     : {len(fo) - len(noex)}")
    print(f"  with param table : {len(fo) - len(notab)}")
    print(f"  with #includeFunc: {sum(1 for e in fo if e['includeFunc'])}")
    print(f"  used in tutorials: {sum(1 for e in fo if e['tutorials'])}")
    if args.verbose:
        print("  no example    :", " ".join(noex) or "-")
        print("  no param table:", " ".join(notab) or "-")


